# Production server for the calculator SPA (ADR-0009).
#
# Rendered at container start by the base image's envsubst entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh), which substitutes only
# variables that exist in the environment — so ${BACKEND_UPSTREAM} is replaced
# while nginx's own $uri, $request_id and friends survive untouched.
#
# Environment:
#   BACKEND_UPSTREAM  host:port of the Go service (default backend:8081)

# Every proxied request reaches the backend with a request id: the caller's
# when it sent a usable one, nginx's own per-request id otherwise. The backend
# echoes it back and logs it, so one id ties the browser, nginx and the API
# together.
map $http_x_request_id $calc_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    # The unprivileged base runs as uid 101 and cannot bind below 1024.
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;

    # Bodies are tiny JSON documents; anything larger is not ours.
    client_max_body_size 64k;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      application/manifest+json image/svg+xml;

    # Container-level liveness. Plain text, no logging: the healthcheck hits
    # it every few seconds and would otherwise drown the access log.
    location = /healthz {
        access_log off;
        include /etc/nginx/security-headers.conf;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API. Because the browser talks to this origin only, the
    # backend needs no CORS allowlist in production (ADR-0009). No trailing
    # slash on proxy_pass: the /api/ prefix is part of the backend's routes.
    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID      $calc_request_id;

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        proxy_pass http://${BACKEND_UPSTREAM};
    }

    # Vite fingerprints every file under /assets/, so the content of a given
    # URL can never change: cache it for a year and never revalidate.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The entry document is the one file that must never be cached, or a
    # browser keeps loading a deployment's old asset hashes.
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback: real files win, everything else renders the app shell.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
